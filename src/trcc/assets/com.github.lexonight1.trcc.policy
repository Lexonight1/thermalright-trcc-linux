<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>TRCC Linux</vendor>
  <vendor_url>https://github.com/Lexonight1/thermalright-trcc-linux</vendor_url>

  <!-- Every action names one of OUR helpers, never a general-purpose program.
       pkexec does no validation of the arguments it passes (man 1 pkexec), so
       an allow_active=yes action is that program as root, with any arguments,
       for every process in the session.  This file used to grant dmidecode
       (dump-bin FILE creates a root-owned file anywhere) and smartctl (its set
       options change drive state).  The read helpers take no arguments and do
       one fixed read; trcc-ram-access takes one of two words and writes two
       fixed files.  The packages install them to /usr/bin on every distro, so
       there is one home per helper. -->

  <action id="com.github.lexonight1.trcc.dmi">
    <description>Read memory module information (SMBIOS type 17)</description>
    <message>TRCC needs to read the memory speed the controller runs.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/trcc-dmi</annotate>
  </action>

  <action id="com.github.lexonight1.trcc.imc">
    <description>Read memory-controller timings (IMC/MCHBAR)</description>
    <message>TRCC needs to read memory-controller timings.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/trcc-imc</annotate>
  </action>

  <!-- The one action that GRANTS something: it lets the user at this seat
       open the chipset SMBus, beside the memory's own settings chips.  So it
       asks for a password on every use.  allow_active=yes here would let any
       program in the session grant itself that bus without a word. -->
  <action id="com.github.lexonight1.trcc.ram-access">
    <description>Turn RAM lighting access on or off</description>
    <message>TRCC needs your password to change who can reach the memory's lighting chips.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/trcc-ram-access</annotate>
  </action>

  <!-- Turning RAM lighting OFF only takes the grant away, so the person at
       the seat needs no password for it.  A separate program, because polkit
       grants a program and never checks its arguments: a password-free
       trcc-ram-access would also be a password-free "enable". -->
  <action id="com.github.lexonight1.trcc.ram-access-off">
    <description>Turn RAM lighting access off</description>
    <message>TRCC needs to remove its access to the memory's lighting chips.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/trcc-ram-access-off</annotate>
  </action>
</policyconfig>
