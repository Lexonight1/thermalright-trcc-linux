<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>TRCC Linux</vendor>
  <vendor_url>https://github.com/Lexonight1/thermalright-trcc-linux</vendor_url>

  <!-- Each tool is declared at BOTH canonical homes.  pkexec matches
       exec.path by exact string against the program's resolved path, and
       where the tool lives depends on the distro: /usr/sbin/ on Debian and
       Ubuntu (a real directory), /usr/bin/ where /usr/sbin is a symlink to
       it (Arch, Fedora 42+).  With /usr/bin alone, every Debian/Ubuntu
       launch asked for a password (#312).  TRCC resolves the path itself
       before calling pkexec, so older pkexec (no realpath) matches too. -->

  <action id="com.github.lexonight1.trcc.dmidecode">
    <description>Read hardware information (SMBIOS/DMI)</description>
    <message>TRCC needs to read memory and motherboard information.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/dmidecode</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="com.github.lexonight1.trcc.dmidecode-sbin">
    <description>Read hardware information (SMBIOS/DMI)</description>
    <message>TRCC needs to read memory and motherboard information.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/dmidecode</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="com.github.lexonight1.trcc.smartctl">
    <description>Read disk health information (SMART)</description>
    <message>TRCC needs to read disk health status.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/smartctl</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="com.github.lexonight1.trcc.smartctl-sbin">
    <description>Read disk health information (SMART)</description>
    <message>TRCC needs to read disk health status.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/smartctl</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="com.github.lexonight1.trcc.imc">
    <description>Read memory-controller timings (IMC/MCHBAR)</description>
    <message>TRCC needs to read memory-controller timings.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/trcc-imc</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
