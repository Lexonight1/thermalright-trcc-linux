SUBSYSTEM=="usb", ATTR{idVendor}=="0416", ATTR{idProduct}=="5406", MODE="0666"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0416", ATTR{idProduct}=="5406", ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="10000"

