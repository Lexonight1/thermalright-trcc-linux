# Thermalright TRCC devices — generated by `trcc system setup` (and packaged)
# Removing this file reverts all registered devices to root-only

# Thermalright LCD Display
SUBSYSTEM=="scsi_generic", ATTRS{idVendor}=="0402", ATTRS{idProduct}=="3922", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="0402", ATTR{idProduct}=="3922", MODE="0666"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0402", ATTR{idProduct}=="3922", ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="10000"

# Winbond USBDISPLAY
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="5302", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="0416", ATTR{idProduct}=="5302", MODE="0666"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0416", ATTR{idProduct}=="5302", ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="10000"

# Winbond LCD Display
