# Thermalright TRCC motherboard RGB — generated by `trcc system setup` (and packaged)
# The user at this seat and the trcc group reach them; removing this file
# takes these controllers back to root-only

# ASUS Aura motherboard RGB
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="18f3", MODE="0660", GROUP="trcc", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0b05", ATTR{idProduct}=="18f3", MODE="0660", GROUP="trcc", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1939", MODE="0660", GROUP="trcc", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0b05", ATTR{idProduct}=="1939", MODE="0660", GROUP="trcc", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="19af", MODE="0660", GROUP="trcc", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0b05", ATTR{idProduct}=="19af", MODE="0660", GROUP="trcc", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1aa6", MODE="0660", GROUP="trcc", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0b05", ATTR{idProduct}=="1aa6", MODE="0660", GROUP="trcc", TAG+="uaccess"
